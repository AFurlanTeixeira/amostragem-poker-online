# =============================================================================
# Variáveis de ambiente — copie este arquivo para .env e ajuste os valores.
# O arquivo .env está no .gitignore.
# Nenhuma delas é obrigatória: os scripts têm defaults via optparse.
# =============================================================================

# -----------------------------------------------------------------------------
# Reprodutibilidade
# -----------------------------------------------------------------------------
# Semente usada nos sorteios e nas simulações. Registre no relatório.
RANDOM_SEED=42

# -----------------------------------------------------------------------------
# Dataset do Kaggle (scripts/simular_kaggle.R) — ver data/raw/README.md
# -----------------------------------------------------------------------------
KAGGLE_PATH=data/raw/kaggle/poker_tournament_survival.csv
# buyin (mesmas faixas do campo), skill (quartis, didático) ou nenhum.
KAGGLE_ESTRATIFICAR_POR=buyin
# Tamanho de cada amostra simulada (use o mesmo n da coleta de campo).
TAMANHO_AMOSTRA=120
# Número de réplicas de Monte Carlo.
N_REPLICAS=5000

# -----------------------------------------------------------------------------
# Sorteio de campo (scripts/sortear_amostra.R)
# -----------------------------------------------------------------------------
N_POR_ESTRATO=2
M_POR_TORNEIO=5
N_RESERVA=0
