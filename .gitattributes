# Normaliza todos os arquivos de texto para LF no repositório.
# Ao fazer checkout, o git entrega LF em qualquer OS.
* text=auto eol=lf

# ─── Texto explícito ──────────────────────────────────────────────────────────
*.R           text eol=lf
*.Rmd         text eol=lf
*.csv         text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.toml        text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.env         text eol=lf
*.example     text eol=lf
*.gitignore   text eol=lf
*.gitattributes text eol=lf
*.editorconfig  text eol=lf
*.txt         text eol=lf
DESCRIPTION   text eol=lf

# ─── Binários — nunca normalizar ─────────────────────────────────────────────
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.svg    binary
*.zip    binary
*.pdf    binary
